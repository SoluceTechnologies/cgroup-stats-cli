#!/bin/sh
# Formats the tree with rustfmt and re-stages what it touched.
# Enable with:  git config core.hooksPath .githooks
set -eu

staged_rust=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
[ -n "$staged_rust" ] || exit 0

command -v cargo >/dev/null 2>&1 || {
    echo "pre-commit: cargo not found, skipping rustfmt" >&2
    exit 0
}

# Which files already had unstaged edits BEFORE formatting. Captured up front,
# because cargo fmt itself creates unstaged edits and would otherwise make
# every reformatted file look partially staged.
already_dirty=$(git diff --name-only -- '*.rs')

cargo fmt --all

echo "$staged_rust" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    if printf '%s\n' "$already_dirty" | grep -qxF -- "$file"; then
        # Re-staging would pull this file's uncommitted work into the commit.
        echo "pre-commit: formatted $file but left it unstaged (it has unstaged changes)"
    else
        git add -- "$file"
    fi
done
